{
  "name": "v-showcase-tools",
  "version": "1.0.0",
  "description": "V-Showcase 编辑器 + AI 批量分析工具（本地运行，不部署）",
  "private": true,
  "type": "module",
  "main": "server/serve.mjs",
  "scripts": {
    "start": "node server/serve.mjs",
    "editor": "node server/serve.mjs",
    "ai": "node ai/build-focal-points.mjs",
    "ai:max": "node ai/build-focal-points.mjs --strategy=max",
    "ai:center": "node ai/build-focal-points.mjs --strategy=center",
    "download": "node ai/build-focal-points.mjs --download-only",
    "audit": "node audit-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "acorn": "^8.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "author": "",
  "license": "MIT"
}
